{
  "$schema": "https://developers.cloudflare.com/workers/wrangler/configuration-schema.json",
  "name": "arcade-racing",
  "main": "worker/index.ts",
  // Pinned to what the bundled local runtime supports (wrangler 3 ships
  // workerd up to 2025-07-18); safe to raise later, nothing here needs newer.
  "compatibility_date": "2025-07-18",
  "compatibility_flags": ["nodejs_compat"],
  // Serve the built Vite app (./dist) from the same origin as the Worker,
  // so the game and multiplayer share one domain.
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "RACE_ROOM",
        "class_name": "RaceRoom"
      }
    ]
  },
  // SQLite-backed Durable Object storage (leaderboard persistence).
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["RaceRoom"]
    }
  ],
  "dev": {
    "port": 8787
  },
  "observability": {
    "enabled": true
  }
}
